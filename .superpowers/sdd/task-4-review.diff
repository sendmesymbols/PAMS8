+      style.stroke,
+      style.strokeWidth,
+      { opacity: this._defaults.opacity },
+      style.strokeDash,
+      this._defaults.arrowType,
+    );
+    this._fc.add(finalObj);
+    this._setTool('select');
+    this._fc.setActiveObject(finalObj);
+    this._fc.requestRenderAll();
+    this._commit();
