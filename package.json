{
  "name": "PAMS8",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-assets": "node -e \"const fs=require('fs');if(!fs.existsSync('public/assets')){fs.cpSync('node_modules/@arcgis/core/assets','public/assets',{recursive:true});console.log('Copied @arcgis/core assets -> public/assets')}\"",
    "predev": "npm run copy-assets",
    "prebuild": "npm run copy-assets",
    "preview": "vite preview",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arcgis/core": "latest"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.14.1",
    "prettier": "^3.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.5.3"
  }
}
