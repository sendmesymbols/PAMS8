{
  "name": "PAMS8",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "copy-assets": "node -e \"const fs=require('fs');if(!fs.existsSync('public/assets')){fs.cpSync('node_modules/@arcgis/core/assets','public/assets',{recursive:true});console.log('Copied @arcgis/core assets -> public/assets')}\"",
    "copy-data": "node -e \"const fs=require('fs');fs.cpSync('MS/Data','dist/MS/Data',{recursive:true});console.log('Copied MS/Data -> dist/MS/Data')\"",
    "copy-thirdparty": "node -e \"const fs=require('fs');fs.cpSync('MS/ThirdParty','dist/MS/ThirdParty',{recursive:true});console.log('Copied MS/ThirdParty -> dist/MS/ThirdParty')\"",
    "copy-styles": "node -e \"const fs=require('fs');fs.cpSync('MS/Styles','dist/MS/Styles',{recursive:true});console.log('Copied MS/Styles -> dist/MS/Styles')\"",
    "predev": "npm run copy-assets",
    "prebuild": "npm run copy-assets",
    "preview": "vite preview",
    "dev": "vite",
    "relay": "node tools/collabRelay.js --port 6600",
    "dev:dist": "vite build && npm run copy-data && npm run copy-thirdparty && npm run copy-styles && npm run copy-docs && vite --mode dist",
    "build": "vite build && npm run copy-data && npm run copy-thirdparty && npm run copy-styles && npm run docs:build && tsc -p tsconfig.build.json",
    "copy-docs": "node -e \"const fs=require('fs');fs.cpSync('MS/Docs','dist/MS/Docs/markdown',{recursive:true});console.log('Copied MS/Docs -> dist/MS/Docs/markdown')\"",
    "docs:catalog": "node tools/genSymbolCatalog.mjs",
    "docs:api": "typedoc",
    "docs:build": "npm run docs:catalog && npm run docs:api && npm run copy-docs"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.14.1",
    "prettier": "^3.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.5.3"
  },
  "dependencies": {
    "@arcgis/core": "5.0.19"
  }
}
